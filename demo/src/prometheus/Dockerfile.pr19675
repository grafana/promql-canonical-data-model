# Builds prometheus/prometheus#19675 (jcreixell/prometheus@rw-relabel, unmerged).
# See model/README.md's "Push ingestion" section.
FROM golang:1.26-bookworm AS build
WORKDIR /src
RUN git clone --branch rw-relabel --single-branch --depth 1 \
    https://github.com/jcreixell/prometheus.git .
RUN go build -o /out/prometheus ./cmd/prometheus

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/prometheus /bin/prometheus
RUN mkdir -p /prometheus
EXPOSE 9090
ENTRYPOINT ["/bin/prometheus"]
