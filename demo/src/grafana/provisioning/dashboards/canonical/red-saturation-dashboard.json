    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Filtered by $operation (default All, aggregated). Selecting a specific operation also drops the shaded band and dashed \"level\" line below, since rules/saafe/anomaly.yml's baseline for this query (anomaly_name=\"canonical_requests\") isn't scoped by operation; a filled marker under \"anomalies\" means AnomalyDetected fired.",
      "datasource": {
        "type": "prometheus",
        "uid": "webstore-metrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "editorMode": "code",
          "expr": "sum by (service, cdm_source) (rate({cdm_metric=\"requests_total\", cdm_source=\"$source\", service=\"$service\", cdm_request_context=~\"$operation\", cdm_direction=\"inbound\"}[5m]))",
          "legendFormat": "request rate",
          "range": true,
          "instant": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "editorMode": "code",
          "expr": "last_over_time(anomaly:lower_band{anomaly_name=\"canonical_requests\", service=\"$service\", cdm_source=\"$source\", cdm_request_context=~\"$operation\"}[2m])",
          "legendFormat": "anomaly_lower_band",
          "range": true,
          "instant": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "editorMode": "code",
          "expr": "last_over_time(anomaly:upper_band{anomaly_name=\"canonical_requests\", service=\"$service\", cdm_source=\"$source\", cdm_request_context=~\"$operation\"}[2m])",
          "legendFormat": "anomaly_upper_band",
          "range": true,
          "instant": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "editorMode": "code",
          "expr": "ALERTS{anomaly_name=\"canonical_requests\", service=\"$service\", cdm_source=\"$source\", cdm_request_context=~\"$operation\", alertstate=\"firing\", anomaly_select=\"1\"}",
          "legendFormat": "anomalies",
          "range": true,
          "instant": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "webstore-metrics"
          },
          "editorMode": "code",
